# AI Video Factory — AI provider environment variables
# Copy this file to `.env` and fill in the keys for the providers you want to use.
# At least one provider key (or the Vercel AI Gateway) is required for arbitrary
# LLM spec generation. Offline template families work without any key.

# Vercel AI Gateway (default, no key strictly required if using gateway free tier)
AI_GATEWAY_API_KEY=

# OpenAI
OPENAI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Google (Gemini)
GEMINI_API_KEY=

# OpenRouter (OpenAI-compatible, models from many providers)
OPENROUTER_API_KEY=

# Ollama Cloud (https://ollama.com — required for cloud models like gpt-oss:120b).
# Leave empty if you only use a local Ollama install at localhost:11434.
OLLAMA_API_KEY=

# Local Ollama (no API key needed when running locally)
OLLAMA_BASE_URL=http://localhost:11434
