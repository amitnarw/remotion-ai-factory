node_modules
dist
.DS_Store
.env

# Ignore generated output directory (videos, reports, specs, reviews, logs)
output/

# Runtime logs
*.log
ui-dev.log

# Probe / debug scratch files
probe*.cts

# Asset download cache
scripts/asset-cache/

