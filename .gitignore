out/

# Generated whatif audio/data (regenerated by generator)
public/whatif-audio/
public/whatif-data/

# Generated voice lines and the voice cache (never commit; the tracked samples stay tracked)
public/voice/
.cache/

# Local archives of the project (for moving between machines)
/*.zip

# Generated audio library (rebuild with `npm run audio:library`)
public/library/
