{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AI Video Factory — Provider Config",
  "description": "Connect any AI provider/model for shot-spec generation. API keys live in .env (never committed).",
  "defaultProvider": "gateway",
  "providers": {
    "gateway": {
      "package": "gateway",
      "apiKeyEnv": "AI_GATEWAY_API_KEY",
      "models": [
        "openai/gpt-5.4",
        "openai/gpt-5-mini",
        "anthropic/claude-sonnet-4-5",
        "google/gemini-2.5-flash",
        "meta-llama/llama-3.3-70b-instruct"
      ]
    },
    "openai": {
      "package": "openai",
      "apiKeyEnv": "OPENAI_API_KEY",
      "models": ["gpt-5.4", "gpt-5-mini", "gpt-4o", "gpt-4o-mini"]
    },
    "anthropic": {
      "package": "anthropic",
      "apiKeyEnv": "ANTHROPIC_API_KEY",
      "models": ["claude-sonnet-4-5", "claude-opus-4-6", "claude-haiku-3-5"]
    },
    "google": {
      "package": "google",
      "apiKeyEnv": "GEMINI_API_KEY",
      "models": ["gemini-2.5-flash", "gemini-2.5-pro"]
    },
    "openrouter": {
      "package": "openai",
      "apiKeyEnv": "OPENROUTER_API_KEY",
      "baseUrl": "https://openrouter.ai/api/v1",
      "models": ["openai/gpt-5-mini", "anthropic/claude-sonnet-4-5", "google/gemini-2.5-flash"]
    },
    "ollama": {
      "package": "openai",
      "baseUrl": "http://localhost:11434/v1",
      "models": ["llama3.3", "qwen2.5-coder", "codellama"]
    }
  }
}
