diff --git a/src/generator/render/root.test.ts b/src/generator/render/root.test.ts
new file mode 100644
index 0000000..5c79a43
--- /dev/null
+++ b/src/generator/render/root.test.ts
@@ -0,0 +1,11 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { canonicalPath } from "./root";
+
+test("a lowercase drive letter is upper-cased; other paths are left as they are", () => {
+  assert.equal(canonicalPath("c:\\Users\\Dell\\repo"), "C:\\Users\\Dell\\repo");
+  assert.equal(canonicalPath("d:/work/repo"), "D:/work/repo");
+  assert.equal(canonicalPath("C:\\Users\\Dell\\repo"), "C:\\Users\\Dell\\repo");
+  assert.equal(canonicalPath("/home/user/repo"), "/home/user/repo");
+  assert.equal(canonicalPath("relative\\c:path"), "relative\\c:path");
+});
diff --git a/src/generator/render/root.ts b/src/generator/render/root.ts
new file mode 100644
index 0000000..d980bdb
--- /dev/null
+++ b/src/generator/render/root.ts
@@ -0,0 +1,18 @@
+/**
+ * src/generator/render/root.ts — the project root with one spelling.
+ *
+ * Windows paths are case-insensitive, but the bundler is not: a bundle made
+ * from a working directory that starts `c:\` instead of `C:\` can resolve a
+ * module twice and render whole frames differently (found 2026-11-12; VS Code
+ * starts the process with either). Every bundle takes its paths from here.
+ */
+
+/** A path with a Windows drive letter upper-cased; any other path as it is. */
+export function canonicalPath(p: string): string {
+  return p.replace(/^([a-z]):/, (_, d: string) => `${d.toUpperCase()}:`);
+}
+
+/** The working directory, as the bundler must see it. */
+export function projectRoot(): string {
+  return canonicalPath(process.cwd());
+}
